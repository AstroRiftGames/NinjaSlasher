  m_text: "<b><size=120%>game design</size></b>\r\njorge huallpa\r\n\r\n\r\n<b><size=120%>programming</size></b>\r\ndaniel
    dieguez\r\ntom\xE1s taboada\r\nwilfredo rukoz\r\n\r\n\r\n<b><size=120%>art</size></b>\r\njuan
